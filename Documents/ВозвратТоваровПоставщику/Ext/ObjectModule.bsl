
Процедура ОбработкаПроведения(Отказ, Режим)
	
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ОстаткиТоваров");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.ИсточникДанных = Товары;
	ЭлементБлокировки.УстановитьЗначение("Склад", Склад);
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Номенклатура", "Номенклатура");
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Серия", "Серия");
	Блокировка.Заблокировать();
	
	
    Движения.ОстаткиТоваров.Записывать = Истина;
    Движения.ОстаткиТоваров.Очистить();
	
	//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВозвратТоваровПоставщикуТовары.Номенклатура КАК Номенклатура,
		|	ВозвратТоваровПоставщикуТовары.Серия КАК Серия,
		|	СУММА(ВозвратТоваровПоставщикуТовары.Количество) КАК Количество
		|ПОМЕСТИТЬ ВТ_ТаблицаДокумента
		|ИЗ
		|	Документ.ВозвратТоваровПоставщику.Товары КАК ВозвратТоваровПоставщикуТовары
		|ГДЕ
		|	ВозвратТоваровПоставщикуТовары.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ВозвратТоваровПоставщикуТовары.Номенклатура,
		|	ВозвратТоваровПоставщикуТовары.Серия
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ТаблицаДокумента.Номенклатура КАК Номенклатура,
		|	ВТ_ТаблицаДокумента.Серия КАК Серия,
		|	ВТ_ТаблицаДокумента.Количество КАК Количество,
		|	ЕСТЬNULL(ОстаткиТоваровОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток,
		|	ЕСТЬNULL(ОстаткиТоваровОстатки.СуммаОстаток, 0) КАК СуммаОстаток
		|ИЗ
		|	ВТ_ТаблицаДокумента КАК ВТ_ТаблицаДокумента
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки(
		|				&МоментВремени,
		|				Склад = &Склад
		|					И (Номенклатура, Серия) В
		|						(ВЫБРАТЬ
		|							ВТ.Номенклатура,
		|							ВТ.Серия
		|						ИЗ
		|							ВТ_ТаблицаДокумента КАК ВТ)) КАК ОстаткиТоваровОстатки
		|		ПО ВТ_ТаблицаДокумента.Номенклатура = ОстаткиТоваровОстатки.Номенклатура
		|			И ВТ_ТаблицаДокумента.Серия = ОстаткиТоваровОстатки.Серия";
	//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	
	Запрос.УстановитьПараметр("МоментВремени", МоментВремени());
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Количество > Выборка.КоличествоОстаток Тогда
			Отказ = Истина;
			Нехватка = Выборка.Количество - Выборка.КоличествоОстаток;
			
			ТекстОшибки = СтрШаблон(
				"Не хватает запчасти «%1» (серия: %2) в количестве %3 шт.", 
				Выборка.Номенклатура, 
				?(ЗначениеЗаполнено(Выборка.Серия), Выборка.Серия, "без серии"), 
				Нехватка
			);
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ТекстОшибки;
			Сообщение.КлючДанных = Ссылка;
			Сообщение.Сообщить();
			
			Продолжить;
		КонецЕсли;
		
		Если Отказ Тогда
			Продолжить;
		КонецЕсли;
		
		СписываемаяСумма = 0;
		
		Если Выборка.Количество = Выборка.КоличествоОстаток Тогда
			СписываемаяСумма = Выборка.СуммаОстаток; 
		Иначе
			СписываемаяСумма = Выборка.Количество * (Выборка.СуммаОстаток / Выборка.КоличествоОстаток);
		КонецЕсли;
		
		Движение = Движения.ОстаткиТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период      = Дата;
		Движение.Склад       = Склад; 
		Движение.Номенклатура = Выборка.Номенклатура;
		Движение.Серия       = Выборка.Серия;
		Движение.Количество  = Выборка.Количество;
		Движение.Сумма       = СписываемаяСумма;
	КонецЦикла;
	
	Движения.ВзаиморасчетыСПоставщиками.Записывать = Истина;
	Движение = Движения.ВзаиморасчетыСПоставщиками.Добавить();
	Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
	Движение.Период = Дата;
	Движение.Поставщик = Поставщик;
	Движение.СуммаДолга = СуммаДокумента;
КонецПроцедуры
